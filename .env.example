# AI provider (server-only): 'anthropic' (default) or 'openai', with the matching key
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Class hub: one sign-in for every class app (server-only). The app must be served under the
# hub's cookie domain, e.g. mpb.preview.cbs-tech-strategy.com.
HUB_URL=https://preview.cbs-tech-strategy.com
HUB_JWT_PUBLIC_KEY=                 # the hub's public key (base64 of the PEM)
HUB_COOKIE_NAME=cts_preview_session
HUB_APP_SLUG=make-partner-buy

# Class hub activity log, reported from the browser with the hub's session cookie
# (build-time: inlined into the page, so a change needs a redeploy)
NEXT_PUBLIC_HUB_URL=https://preview.cbs-tech-strategy.com
NEXT_PUBLIC_HUB_APP_SLUG=make-partner-buy

# Pages allowed to embed the app in a frame (CSP frame-ancestors, space-separated; build-time).
# Default: https://preview.cbs-tech-strategy.com https://*.preview.cbs-tech-strategy.com
HUB_FRAME_ANCESTORS=
